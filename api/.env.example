# =============================================================
# MAM Academy — API environment (PHP backend)
# Copy to api/.env on your server and fill values. .env is denied
# by .htaccess and never reaches the browser.
# =============================================================

# ---- App ----
APP_ENV=production
APP_URL=https://academy.mamcentre.org
ALLOWED_ORIGINS=https://academy.mamcentre.org,https://www.mamcentre.org

# ---- Database ----
# Default (no config): SQLite at api/storage/mam.db, schema auto-migrates.
# Production: set DB_DSN to a PDO connection string. Schema is shipped
# at db/schema-mysql.sql — apply it once before the first deploy.
#
# Example:
#   DB_DSN=mysql:host=localhost;dbname=mam;charset=utf8mb4
DB_DSN=
DB_USERNAME=
DB_PASSWORD=

# ---- Paystack ----
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Set in Paystack dashboard → Webhooks; we verify x-paystack-signature
PAYSTACK_WEBHOOK_SECRET=

# ---- Flutterwave ----
FLW_SECRET_KEY=
# The inline modal cannot open without this; the Flutterwave option refuses
# at /api/payment/initialize when it is blank.
FLW_PUBLIC_KEY=
FLW_ENCRYPTION_KEY=
# Set in Flutterwave dashboard → Settings → Webhooks
FLW_WEBHOOK_HASH=

# ---- Stripe (optional) ----
# Without STRIPE_SECRET_KEY the Stripe option refuses at /api/payment/initialize
# and tells the applicant to use another method, rather than failing in the
# browser after the form is filled in.
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
# Stripe dashboard -> Developers -> Webhooks. Endpoint:
#   https://<your-domain>/api/payment/webhook/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded
# Without this the money can land while the application still reads unpaid,
# because a payer whose connection drops on the redirect never comes back to
# the verify step.
STRIPE_WEBHOOK_SECRET=

# ---- Email (SMTP) ----
# Leave blank to fall back to PHP mail()
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_EMAIL=no-reply@mamcentre.org
MAIL_FROM_NAME="MAM Academy"
NOTIFY_EMAIL=connect@mamcentre.org

# ---- Admin ----
# Generate via:  php -r "echo password_hash('your-password', PASSWORD_BCRYPT), \"\n\";"
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
# Hex string ≥ 32 chars; used for CSRF tokens & cookie integrity
APP_KEY=

# ---- Rate limits ----
RATE_LIMIT_APPLY=10
RATE_LIMIT_APPLY_WINDOW=600
RATE_LIMIT_GENERAL=60
RATE_LIMIT_GENERAL_WINDOW=300

# ---- FX (used for amount checks; UI uses its own table) ----
USD_TO_NGN=1500

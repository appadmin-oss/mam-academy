# Copy to api/.env on your server and fill in the values.
# .env is denied by .htaccess and never reaches the browser.

# Paystack secret key — starts with sk_test_ or sk_live_
PAYSTACK_SECRET_KEY=

# Origin that may call this endpoint (CORS)
ALLOWED_ORIGIN=https://academy.mamcentre.org

# Optional inbox notified after every verified payment
NOTIFY_EMAIL=connect@mamcentre.org

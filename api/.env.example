# =============================================================
# MAM Academy — API environment (PHP backend)
# Copy to api/.env on your server and fill values. .env is denied
# by .htaccess and never reaches the browser.
# =============================================================

# ---- App ----
APP_ENV=production
APP_URL=https://academy.mamcentre.org
ALLOWED_ORIGINS=https://academy.mamcentre.org,https://www.mamcentre.org
# Gate for the operator diagnostics (/api/diag full view + /api/raw-debug.php).
# Long random string; call with ?key=<token>. Empty = raw-debug refuses and
# /api/diag serves only the restricted summary (admins still see everything).
DEBUG_TOKEN=
# Session-cookie Secure flag: 1/true forces it (recommended behind any proxy),
# 0/false disables (plain-HTTP local dev), empty = auto-detect from HTTPS /
# X-Forwarded-Proto.
COOKIE_SECURE=1
# Trusted reverse-proxy/CDN ranges (comma-separated CIDRs). The client IP used
# for rate-limiting + audit is read from CF-Connecting-IP / X-Forwarded-For ONLY
# when the direct peer is in this set — otherwise a client could spoof its IP to
# dodge per-IP limits. Empty = built-in default (private ranges + Cloudflare's
# published edges). Set this if you front the app with a non-Cloudflare proxy.
TRUSTED_PROXY_CIDRS=

# ---- Database ----
# Default (no config): SQLite at api/storage/mam.db, schema auto-migrates.
# Production: set DB_DSN to a PDO connection string. Schema is shipped
# at db/schema-mysql.sql — apply it once before the first deploy.
#
# Example:
#   DB_DSN=mysql:host=localhost;dbname=mam;charset=utf8mb4
DB_DSN=
DB_USERNAME=
DB_PASSWORD=

# ---- Paystack ----
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Paystack signs webhooks with your SECRET KEY (HMAC-SHA512) — there is no
# separate webhook secret. Leave this blank and we use PAYSTACK_SECRET_KEY.
# Only set it if you deliberately rotate to a distinct signing secret.
PAYSTACK_WEBHOOK_SECRET=

# ---- Flutterwave ----
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_ENCRYPTION_KEY=
# Set in Flutterwave dashboard → Settings → Webhooks
FLW_WEBHOOK_HASH=

# ---- Stripe (optional) ----
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Email (SMTP) ----
# Transport: if PHPMailer is installed (run `composer install` in api/), it's
# used automatically; otherwise the built-in SMTP client handles delivery.
# Both read the MAIL_* settings below — no code change needed either way.
# Default config below targets mail.mamcentre.org (cPanel/Plesk mailbox).
# Replace MAIL_PASSWORD with the real mailbox password and test with:
#   php api/tools/mail-test.php you@example.com
# Leave MAIL_HOST blank to fall back to PHP mail() (NOT recommended — most
# hosts have no MTA and the call silently disappears).
#
# ⚠  THE #1 CAUSE OF "EMAILS DON'T WORK": MAIL_PASSWORD is left empty below.
#    With a username set but no password, SMTP auth fails and nothing sends.
#    Set the real mailbox password before going live.
# ⚠  DELIVERABILITY: SMTP working ≠ inbox. Publish SPF + enable DKIM for the
#    sending domain or mail lands in spam / is rejected (add DMARC after).
# Failed sends are retained in the mail_log outbox and can be re-sent from the
# admin dashboard, or on cron: php api/tools/mail-retry.php
MAIL_HOST=mail.mamcentre.org
MAIL_PORT=587
MAIL_USERNAME=no-reply@mamcentre.org
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_EMAIL=no-reply@mamcentre.org
MAIL_FROM_NAME="MAM Academy"
NOTIFY_EMAIL=connect@mamcentre.org
# Refuse to fall back to PHP mail() if MAIL_HOST is empty. Recommended in
# production — most shared hosts have no MTA and mail() silently swallows
# the message. With this on, the mailer hard-fails and logs instead.
MAIL_FORCE_SMTP=0
# Hostname to use in the SMTP EHLO greeting. Optional — defaults to
# SERVER_NAME / APP_URL host / gethostname().
MAIL_EHLO_HOST=
# SMTP TLS verification. Default 0 = encrypted-but-UNVERIFIED (verify_peer off):
# the shared-host reality where the relay presents a cert for the server
# hostname (server123.host.com) instead of mail.yourdomain — the classic cPanel
# mismatch that otherwise fails every TLS handshake so nothing sends.
# STRONGLY set MAIL_STRICT_TLS=1 whenever your relay presents a VALID cert
# (Gmail / SES / SendGrid / Mailgun / Postmark all do) — that closes the
# man-in-the-middle window on your SMTP credentials and message bodies.
MAIL_STRICT_TLS=0

# ---- Power Play (free monthly session) ----
# Used by the registration confirmation email to state the next session.
# Held the first Wednesday of every month; tweak the time/timezone/link.
POWERPLAY_TIME=19:00
POWERPLAY_TIMEZONE=Africa/Lagos
POWERPLAY_MEET_URL=

# ---- Application abandonment recovery (cron: api/tools/recovery-email.php) ----
# Email applicants who submitted but never paid, once, inside this window.
RECOVERY_MIN_AGE_HOURS=24
RECOVERY_MAX_AGE_DAYS=7

# Alternative provider recipes (uncomment one and comment out the block above):
#
# Gmail / Google Workspace (needs App Password, NOT your login password):
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=yourname@your-domain.com
#   MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
#   MAIL_ENCRYPTION=tls
#
# Brevo (Sendinblue) — free tier 300/day:
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=587
#   MAIL_USERNAME=your-login@example.com
#   MAIL_PASSWORD=xsmtpsib-xxxxxxxxxxxx-xxxxx
#   MAIL_ENCRYPTION=tls
#
# Mailgun (US region):
#   MAIL_HOST=smtp.mailgun.org
#   MAIL_PORT=587
#   MAIL_USERNAME=postmaster@mg.your-domain.com
#   MAIL_PASSWORD=your-mailgun-smtp-password
#   MAIL_ENCRYPTION=tls
#
# Postmark:
#   MAIL_HOST=smtp.postmarkapp.com
#   MAIL_PORT=587
#   MAIL_USERNAME=your-server-api-token
#   MAIL_PASSWORD=your-server-api-token
#   MAIL_ENCRYPTION=tls

# ---- Admin ----
# Generate a hash via:  php -r "echo password_hash('your-password', PASSWORD_BCRYPT), \"\n\";"
# Legacy HTTP Basic Auth break-glass for /admin/ (works before any DB user exists):
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
# First-run admin auto-provisioning (optional). On a fresh install the first
# login attempt (or any request) seeds an admin user from these, so sign-in
# works with zero manual steps. Use ADMIN_PASSWORD *or* ADMIN_PASSWORD_HASH.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# Optional guard for the browser installer at /api/setup. When set, the URL
# must include ?token=THIS. The installer self-disables once any user exists.
# Alternatively create the admin from the shell:
#   php api/bin/create-admin.php you@example.com 'your-password' 'Your Name'
SETUP_TOKEN=
# Hex string ≥ 32 chars; used for CSRF tokens & cookie integrity
APP_KEY=

# ---- Rate limits ----
RATE_LIMIT_APPLY=10
RATE_LIMIT_APPLY_WINDOW=600
RATE_LIMIT_GENERAL=60
RATE_LIMIT_GENERAL_WINDOW=300

# ---- FX / USD→NGN exchange rate ----
# The naira rate is fetched live from a free, key-less provider, cached ~6h, and
# falls back to USD_TO_NGN below whenever the provider is off/unreachable.
# Toggle auto-update and edit the fallback from /admin (fx_auto, usd_to_ngn).
# FX_RATE_URL overrides the provider — must return JSON with rates.NGN (or
# conversion_rates.NGN). Set it to whatever host your server's egress allows.
USD_TO_NGN=1500
# FX_RATE_URL=https://open.er-api.com/v6/latest/USD

# ---- AI (provider-agnostic gateway · api/lib/ai.php) ----
# FREE BY DEFAULT and OFF until you opt in. Set AI_PROVIDER to enable AI
# features (progress narratives, practice coach, grading assist, placement).
# With AI_PROVIDER unset/none, AI features stay off and the manual flow is
# unaffected — nothing is ever sent anywhere.
#
#   none        (default) AI disabled
#   ollama      self-hosted open models, $0, data NEVER leaves the box — best
#               for student PII. Run Ollama locally; default base/model below.
#   groq        free-tier, fast hosted open models (needs AI_API_KEY)
#   openrouter  routes to many free/cheap models (needs AI_API_KEY)
#   mistral     Mistral hosted (needs AI_API_KEY)
#   openai_compat  any OpenAI-compatible endpoint — set AI_BASE_URL yourself
#   mock        offline echo, for local dev/tests only
#
# Premium (e.g. Claude) is opt-in per use-case and never required.
AI_PROVIDER=none
# To turn on the "Find Your Path" advisor note + other AI features with Groq's
# free, fast tier, set:
#   AI_PROVIDER=groq
#   AI_API_KEY=gsk_...           (from https://console.groq.com/keys)
# (preset model: llama-3.3-70b-versatile; override with AI_MODEL if you like.)
# Override the endpoint/model/key (presets fill sensible defaults per provider):
# AI_BASE_URL=http://localhost:11434/v1     # e.g. Ollama
# AI_MODEL=llama3.2
# AI_API_KEY=                               # required only for hosted providers
# Per-day call cap (admin setting ai_daily_cap; <=0 = unlimited).

# ── Google Drive file uploads (#5) — via an Apps Script web app, NO OAuth ──
# Deploy the web app in docs/drive-apps-script.md, then set both of these to
# enable instructor file uploads (lesson videos/materials → Drive → resource).
# Off (no uploads) until both URL and secret are set.
# DRIVE_WEBAPP_URL=https://script.google.com/macros/s/AKfy.../exec
# DRIVE_SHARED_SECRET=            # same value as the Apps Script SHARED_SECRET
# DRIVE_FOLDER_ID=                # optional target folder (matches the script)
# DRIVE_MAX_MB=256                # per-file upload cap (admin setting drive_max_mb)
# DRIVE_TRANSPORT=live            # 'mock' = in-process store for local dev/tests

# =============================================================================
# Companion for the one-shot database export tool.
# Upload as  dbexport/.htaccess  beside  dbexport/index.php  (export-web.php).
# =============================================================================
# Delete the whole folder once you have the .zip.
#
# This file is not decoration. Two things in the site-wide .htaccess would
# otherwise work against a full-database download:
#
#  1. `Header set Cache-Control "public, max-age=300, must-revalidate"` applies
#     to every *.php response. mod_headers runs AFTER PHP, so it OVERWRITES the
#     `no-store` the export script sends — inviting a browser or proxy to keep
#     a copy of every user, payment and audit row for five minutes.
#
#  2. The clean-URL rules 301 `/dbexport/index.php` to `/dbexport/index`.
#     Harmless for the folder URL, but `RewriteEngine Off` here removes the
#     hop entirely so a token in the query string is never bounced through a
#     redirect that a proxy log might keep.

DirectoryIndex index.php
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine Off
</IfModule>

<IfModule mod_headers.c>
  # `always` so it applies on the download response, and unset first because
  # `set` from a parent directory would otherwise still be in the table.
  Header unset Cache-Control
  Header always set Cache-Control "no-store, no-cache, must-revalidate, private"
  Header always set Pragma "no-cache"
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

# Deliberately no clever FilesMatch deny-list here. The folder holds exactly two
# files, Apache already refuses to serve .htaccess itself, and a mis-typed
# pattern would 403 the tool — reproducing the confusion this file exists to
# clear up. `Options -Indexes` above is what stops the folder being browsed.

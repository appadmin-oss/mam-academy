# =============================================================
# /api/.htaccess — MAM Academy API (minimal)
# Routes /api/<anything> through index.php. Deliberately does NOT
# set any PHP handler directives — those are controlled by your
# host's cPanel/MultiPHP config, and any AddHandler/AddType here
# was conflicting with that, causing PHP source to leak.
# =============================================================

DirectoryIndex index.php

# Disable MultiViews + directory listings.
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /api/

  # If the request hits an actual file (e.g. index.php), let it serve.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Empty path → health probe.
  RewriteRule ^$ index.php?route=health [L]

  # Everything else → router.
  RewriteRule ^(.+)$ index.php?route=$1 [QSA,L]
</IfModule>

# Block direct access to secrets, db files, logs, and the route /
# lib subdirectories. The router controls all access.
<FilesMatch "\.(env|sqlite|sqlite3|db|log|bak|ini|json|md|sh|sql)$">
  Require all denied
</FilesMatch>
RedirectMatch 403 ^/api/(lib|routes)/.*$

# /api/.htaccess
# Routes /api/<anything> through /api/index.php, which then dispatches.
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /api/

  # Don't rewrite if the request is for an actual existing file (e.g. verify-payment.php legacy)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Health is reachable at /api/health → routes to index.php?route=health
  RewriteRule ^(.+)$ index.php?route=$1 [QSA,L]
  RewriteRule ^$ index.php?route=health [L]
</IfModule>

# Hide library and storage directories from direct browsing
<FilesMatch "\.(env|sqlite|sqlite3|db|log|bak)$">
  Require all denied
</FilesMatch>

# Make sure PHP is parsed
AddHandler application/x-httpd-php .php

# =============================================================
# /api/.htaccess — MAM Academy API
# =============================================================

DirectoryIndex index.php
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /api/

  # CRITICAL: forward the Authorization header to PHP. cPanel / LiteSpeed
  # / many shared FastCGI setups strip `Authorization` before PHP sees
  # it, which empties $_SERVER['PHP_AUTH_USER'] / $_SERVER['PHP_AUTH_PW']
  # even when the browser is sending valid Basic-Auth credentials. The
  # admin login then re-prompts forever. This rule re-injects it as
  # HTTP_AUTHORIZATION so auth.php can decode it.
  RewriteCond %{HTTP:Authorization} ^(.+)$
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

  # If the request hits an actual file, serve it directly.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Empty path → health probe.
  RewriteRule ^$ index.php?route=health [L]

  # Everything else → router.
  RewriteRule ^(.+)$ index.php?route=$1 [QSA,L]
</IfModule>

# Some hosts ignore the rewrite-based forwarding above; SetEnvIf is the
# belt-and-braces alternative. One of the two will land.
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

<FilesMatch "\.(env|sqlite|sqlite3|db|log|bak|ini|json|md|sh|sql)$">
  Require all denied
</FilesMatch>
RedirectMatch 403 ^/api/(lib|routes)/.*$

api/logs/*.log
api/storage/mam.db*
api/storage/.app_key
api/.env
api/storage/og/
# ETL snapshots hold a full copy of the database — identity, payments,
# audit and consent rows. They are a rollback artifact, never a commit.
api/storage/export/
# Uploaded headshots — real people's photographs, never committed.
api/storage/uploads/
# The job runner's flock. Running the cron on a checkout left this in
# `git status`, where the repo's own rule is to stage paths explicitly —
# so a `git add -A` would have committed a runtime lock.
api/storage/.run-jobs.lock

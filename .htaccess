# ============================================================
# MAM Academy — Apache .htaccess
# Shared-host friendly: caching, gzip, security headers, pretty
# URLs (optional) and HTTPS redirect.
# ============================================================

# Default index
DirectoryIndex index.php index.html index.htm

# ---------- HTTPS redirect ----------
# Cloudflare-aware: behind CF the origin connection may legitimately be HTTP
# (Flexible SSL), so redirecting on %{HTTPS}!=on alone causes an infinite loop.
# Only redirect when the *visitor* used http, which CF reports in
# X-Forwarded-Proto. Direct-to-origin (no XFP) also redirects when not on HTTPS.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} ^$
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# ---------- Clean (extensionless) URLs ----------
# Canonical form is /about, not /about.html. Two rules:
#   1. 301 any direct request for /foo.html → /foo (one canonical URL,
#      good for SEO and avoids duplicate-content). The %{THE_REQUEST}
#      guard means it only fires on the *original* browser request, so
#      it never loops with the internal rewrite below.
#   2. Internally serve /foo by mapping to /foo.html when that file exists.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forward the Authorization header to PHP. cPanel / LiteSpeed / many
  # shared FastCGI setups strip `Authorization` before PHP sees it,
  # which empties $_SERVER['PHP_AUTH_USER'] / $_SERVER['PHP_AUTH_PW']
  # and makes /admin re-prompt forever for Basic-Auth credentials.
  RewriteCond %{HTTP:Authorization} ^(.+)$
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

  # Never touch /api/* — the api directory has its own .htaccess router.
  RewriteRule ^api(/|$) - [L]

  # /studio is the renamed user-facing URL for the Practice Studio. Internally
  # both /studio and /tools serve the tools page — the old URL keeps working so
  # existing email links / bookmarks / sitemaps don't 404.
  RewriteRule ^studio/?$ tools.php [L]

  # 1. External redirect: strip .html / .php from the URL so the clean URL is
  #    canonical (good for SEO, avoids duplicate content). %{THE_REQUEST} guards
  #    so it only fires on the original browser request, never the internal
  #    rewrite below. Skips /partials/* (fetched directly when needed).
  RewriteCond %{REQUEST_URI} !^/partials/ [NC]
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.(?:html|php)[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # 2. Internal rewrite: serve the page for the clean URL. Prefer a
  #    server-side-included .php (header/footer rendered in-page, no client
  #    fetch — better CLS/SEO); fall back to a legacy .html if no .php exists,
  #    so the migration is non-destructive and incremental.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ---------- 404 ----------
ErrorDocument 404 /404.php

# ---------- Gzip ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml application/xhtml+xml
  AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf application/font-woff application/font-woff2
</IfModule>

# ---------- Brotli (if available) ----------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ---------- Caching ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                              "access plus 1 month"
  ExpiresByType text/html                     "access plus 5 minutes"
  ExpiresByType text/css                      "access plus 1 year"
  ExpiresByType application/javascript        "access plus 1 year"
  ExpiresByType application/json              "access plus 0 seconds"
  ExpiresByType image/svg+xml                 "access plus 1 year"
  ExpiresByType image/png                     "access plus 1 year"
  ExpiresByType image/jpeg                    "access plus 1 year"
  ExpiresByType image/webp                    "access plus 1 year"
  ExpiresByType image/avif                    "access plus 1 year"
  ExpiresByType font/woff                     "access plus 1 year"
  ExpiresByType font/woff2                    "access plus 1 year"
  ExpiresByType application/manifest+json     "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  # ----- Security headers -----
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # microphone=(self) lets /studio (the Practice Studio tuner) access mic
  # only when the page is served from this origin. camera + geolocation
  # remain blocked site-wide.
  Header set Permissions-Policy "camera=(), microphone=(self), geolocation=(), interest-cohort=()"
  # HSTS. Only emitted on a secure request (direct HTTPS, or CF/proxy reporting
  # X-Forwarded-Proto: https) so it's never sent over a plain-HTTP hop.
  SetEnvIf X-Forwarded-Proto "https" MAM_HTTPS=1
  SetEnvIf HTTPS "on" MAM_HTTPS=1
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=MAM_HTTPS
  # CSP — relaxed for inline styles/scripts. Notes on the allow-list:
  #  • script-src includes blob: so Web-Audio AudioWorklet / blob-URL module
  #    scripts (Tone.js) load; cdn.jsdelivr.net covers Tone, Zustand (+esm),
  #    pitchy and the rest of the libs.
  #  • connect-src https: covers the sampled-piano fetch (tonejs.github.io),
  #    the FX/geo APIs and same-origin /api calls.
  #  • frame-src includes calendar.google.com for the /book appointment embed.
  Header set Content-Security-Policy "default-src 'self' https:; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob: https://js.paystack.co https://checkout.flutterwave.com https://js.stripe.com https://cdn.jsdelivr.net https://unpkg.com https://code.iconify.design https://api.iconify.design; frame-src 'self' https://checkout.flutterwave.com https://standard.paystack.co https://js.stripe.com https://calendar.google.com; connect-src 'self' https: blob:; worker-src 'self' blob:; media-src 'self' https: blob: data:; manifest-src 'self';"

  # The embeddable metronome widget (/embed) is meant to be framed by partner
  # sites, so it opts OUT of the site-wide SAMEORIGIN frame lock. The global CSP
  # above still applies (it sets no frame-ancestors, so framing is allowed); the
  # widget loads only its own inline code and needs no mic/camera.
  <Files "embed.php">
    Header unset X-Frame-Options
  </Files>

  # ----- Cache-control fine-tuning -----
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|svg|woff|woff2|ttf|otf|png|jpg|jpeg|webp|avif|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "config\.js$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------- MIME types ----------
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
</IfModule>

# ---------- Block sensitive files ----------
<FilesMatch "(^\.|~$|\.bak$|\.log$|\.sql$|\.git|composer\.(json|lock))">
  Require all denied
</FilesMatch>

# Protect the api directory secrets
<Files ".env">
  Require all denied
</Files>

# Disable directory listing
Options -Indexes

# Authorization-header forwarding via SetEnvIf — belt-and-braces partner
# to the RewriteRule above. One of them will land on whichever host
# stripping behaviour your shared environment has.
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

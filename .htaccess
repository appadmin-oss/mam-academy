# ============================================================
# MAM Academy — Apache .htaccess
# Shared-host friendly: caching, gzip, security headers, pretty
# URLs (optional) and HTTPS redirect.
# ============================================================

# Default index
DirectoryIndex index.html index.htm

# ---------- HTTPS redirect ----------
# The active, proxy-aware redirect lives in the mod_rewrite block below (it
# needs RewriteEngine On). It forces HTTPS while honouring X-Forwarded-Proto,
# so it never loops behind a TLS-terminating CDN/proxy such as Cloudflare.

# ---------- Clean (extensionless) URLs ----------
# Canonical form is /about, not /about.html. Two rules:
#   1. 301 any direct request for /foo.html → /foo (one canonical URL,
#      good for SEO and avoids duplicate-content). The %{THE_REQUEST}
#      guard means it only fires on the *original* browser request, so
#      it never loops with the internal rewrite below.
#   2. Internally serve /foo by mapping to /foo.html when that file exists.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forward the Authorization header to PHP. cPanel / LiteSpeed / many
  # shared FastCGI setups strip `Authorization` before PHP sees it,
  # which empties $_SERVER['PHP_AUTH_USER'] / $_SERVER['PHP_AUTH_PW']
  # and makes /admin re-prompt forever for Basic-Auth credentials.
  RewriteCond %{HTTP:Authorization} ^(.+)$
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

  # Force HTTPS. The request counts as already-secure if EITHER Apache's HTTPS
  # is on OR the edge forwarded it over TLS (X-Forwarded-Proto: https) — without
  # that second condition this loops forever behind a TLS-terminating proxy like
  # Cloudflare. 301 so browsers and search engines remember the canonical scheme.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Never touch /api/* — the api directory has its own .htaccess router.
  RewriteRule ^api(/|$) - [L]

  # /studio is the renamed user-facing URL for the Practice Studio. Internally
  # both /studio and /tools serve tools.html — the old URL keeps working so
  # existing email links / bookmarks / sitemaps don't 404.
  RewriteRule ^studio/?$ tools.html [L]

  # 1. External redirect: strip .html from the URL. Skips /partials/*,
  #    which are fetched directly as .html by the front-end loader, so we
  #    don't add a redirect hop to every page's header/footer fetch.
  RewriteCond %{REQUEST_URI} !^/partials/ [NC]
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # 2. Internal rewrite: serve the .html file for the clean URL.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ---------- 404 ----------
ErrorDocument 404 /404.html

# ---------- Gzip ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml application/xhtml+xml
  AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf application/font-woff application/font-woff2
</IfModule>

# ---------- Brotli (if available) ----------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ---------- Caching ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                              "access plus 1 month"
  ExpiresByType text/html                     "access plus 5 minutes"
  ExpiresByType text/css                      "access plus 1 year"
  ExpiresByType application/javascript        "access plus 1 year"
  ExpiresByType application/json              "access plus 0 seconds"
  ExpiresByType image/svg+xml                 "access plus 1 year"
  ExpiresByType image/png                     "access plus 1 year"
  ExpiresByType image/jpeg                    "access plus 1 year"
  ExpiresByType image/webp                    "access plus 1 year"
  ExpiresByType image/avif                    "access plus 1 year"
  ExpiresByType font/woff                     "access plus 1 year"
  ExpiresByType font/woff2                    "access plus 1 year"
  ExpiresByType application/manifest+json     "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  # ----- Security headers -----
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # microphone=(self) lets /studio (the Practice Studio tuner) access mic
  # only when the page is served from this origin. camera + geolocation
  # remain blocked site-wide.
  Header set Permissions-Policy "camera=(), microphone=(self), geolocation=(), interest-cohort=()"
  # HSTS. Browsers ignore this header when it arrives over plain HTTP, so it is
  # safe to send unconditionally — only HTTPS clients act on it. `preload` is
  # deliberately omitted: it's a hard-to-reverse commitment that also binds
  # every subdomain. Add it (and submit to hstspreload.org) only once you're
  # certain the whole domain is HTTPS-only.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # CSP — relaxed for inline styles/scripts. Notes on the allow-list:
  #  • script-src KEEPS 'unsafe-inline': the static .html pages use inline
  #    <script> blocks and on* handlers (e.g. <img onerror>), and being static
  #    files they can't carry a per-request nonce. Removing it needs a build/
  #    render step to externalise every inline script first.
  #  • script-src includes blob: so Web-Audio AudioWorklet / blob-URL module
  #    scripts (Tone.js) load; cdn.jsdelivr.net covers Tone, Zustand (+esm),
  #    pitchy and the rest of the libs.
  #  • connect-src https: covers the sampled-piano fetch (tonejs.github.io),
  #    the FX/geo APIs and same-origin /api calls.
  #  • frame-src includes calendar.google.com for the /book appointment embed.
  #  • object-src 'none' kills plugin/<embed> injection; base-uri 'self' blocks
  #    <base>-tag hijacking of every relative URL; frame-ancestors 'self' is the
  #    modern clickjacking guard (mirrors X-Frame-Options); form-action limits
  #    where <form>s can post (same-origin + the hosted checkout redirects).
  Header set Content-Security-Policy "default-src 'self' https:; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob: https://js.paystack.co https://checkout.flutterwave.com https://js.stripe.com https://cdn.jsdelivr.net https://unpkg.com https://code.iconify.design https://api.iconify.design; frame-src 'self' https://checkout.flutterwave.com https://standard.paystack.co https://js.stripe.com https://calendar.google.com; connect-src 'self' https: blob:; worker-src 'self' blob:; media-src 'self' https: blob: data:; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self' https://checkout.flutterwave.com https://standard.paystack.co;"

  # ----- Cache-control fine-tuning -----
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|svg|woff|woff2|ttf|otf|png|jpg|jpeg|webp|avif|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "config\.js$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------- MIME types ----------
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
</IfModule>

# ---------- Block sensitive files ----------
<FilesMatch "(^\.|~$|\.bak$|\.log$|\.sql$|\.git|composer\.(json|lock))">
  Require all denied
</FilesMatch>

# Protect the api directory secrets
<Files ".env">
  Require all denied
</Files>

# Disable directory listing
Options -Indexes

# Authorization-header forwarding via SetEnvIf — belt-and-braces partner
# to the RewriteRule above. One of them will land on whichever host
# stripping behaviour your shared environment has.
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>
